# Conexión a MySQL (Clientes)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=db_clientes
MYSQL_USER=root
MYSQL_PASSWORD=rootpassword

# Conexión a PostgreSQL (Vehículos)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=db_vehiculos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword

# Conexión a MongoDB (Envíos)
MONGO_URI=mongodb://admin:mongopassword@127.0.0.1:27017/envios_db?authSource=admin

# Cantidad de registros a generar
SEED_TOTAL=25000
